[debug] [2026-10-21T01:32:43.109Z] >>> [apiv2][body] PUT http://127.0.0.1:8085/emulator/v1/projects/demo-no-project:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function isValidId(id) {\n      return id is string && id.matches('^[a-zA-Z0-9_\\\\-]+$') && id.size() <= 100;\n    }\n\n    function isValidSchoolSettings(data) {\n      return data.schoolName is string && data.schoolName.size() <= 200 &&\n             data.accreditation is string && data.accreditation.size() <= 20;\n    }\n\n    function isValidStudent(data) {\n      return data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 200 &&\n             data.classLevel is int && data.classLevel >= 1 && data.classLevel <= 6 &&\n             data.rombel is string && data.rombel.size() <= 50;\n    }\n\n    function isValidPpdb(data) {\n      return data.regNumber is string && data.regNumber.size() >= 1 && data.regNumber.size() <= 50 &&\n             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 200 &&\n             data.status is string && data.status.size() <= 30;\n    }\n\n    function isValidFacility(data) {\n      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&\n             data.category is string && data.category.size() <= 100;\n    }\n\n    function isValidSchedule(data) {\n      return data.day is string && data.day.size() >= 1 && data.day.size() <= 50 &&\n             data.morningEntry is string && data.morningEntry.size() <= 50;\n    }\n\n    function isValidNotification(data) {\n      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&\n             data.content is string && data.content.size() <= 5000;\n    }\n\n    // School Settings (General info, Visi, Misi, Kontak, Sosmed)\n    match /school_settings/{settingId} {\n      allow get: if true;\n      allow list: if true;\n      allow create, update: if isSignedIn() && isValidId(settingId) && isValidSchoolSettings(incoming());\n      allow delete: if isSignedIn() && isValidId(settingId);\n    }\n\n    // Student Master Data\n    match /students/{studentId} {\n      allow get: if true;\n      allow list: if true;\n      allow create, update: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming());\n      allow delete: if isSignedIn() && isValidId(studentId);\n    }\n\n    // PPDB Online Registration\n    match /ppdb/{ppdbId} {\n      allow create: if isValidId(ppdbId) && isValidPpdb(incoming());\n      allow get: if isSignedIn() && isValidId(ppdbId);\n      allow list: if isSignedIn();\n      allow update: if isSignedIn() && isValidId(ppdbId);\n      allow delete: if isSignedIn() && isValidId(ppdbId);\n    }\n\n    // Facilities\n    match /facilities/{facilityId} {\n      allow get: if true;\n      allow list: if true;\n      allow create, update: if isSignedIn() && isValidId(facilityId) && isValidFacility(incoming());\n      allow delete: if isSignedIn() && isValidId(facilityId);\n    }\n\n    // Daily Schedules\n    match /schedules/{scheduleId} {\n      allow get: if true;\n      allow list: if true;\n      allow create, update: if isSignedIn() && isValidId(scheduleId) && isValidSchedule(incoming());\n      allow delete: if isSignedIn() && isValidId(scheduleId);\n    }\n\n    // Notifications / Announcements\n    match /notifications/{notificationId} {\n      allow get: if true;\n      allow list: if true;\n      allow create, update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());\n      allow delete: if isSignedIn() && isValidId(notificationId);\n    }\n\n    // Admin Users\n    match /users/{userId} {\n      allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;\n    }\n  }\n}\n"}]}}
